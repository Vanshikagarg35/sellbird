# copy this file to .env
# no api keys needed, everything is local

OLLAMA_URL=http://localhost:11434
# leave empty to auto select based on your RAM/GPU
MODEL_NAME=
EMBED_MODEL=all-MiniLM-L6-v2
OLLAMA_TIMEOUT=180
# set to 1 after the embedding model is downloaded once, so it does not try internet
HF_HUB_OFFLINE=0
